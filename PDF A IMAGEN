input_folder = r"C:\Users\paginas_divididas"   
output_folder = os.path.join(input_folder, "imagenes")
os.makedirs(output_folder, exist_ok=True)


for file in os.listdir(input_folder):
    if file.endswith(".pdf"):
        pdf_path = os.path.join(input_folder, file)
        doc = fitz.open(pdf_path)

        for page_num, page in enumerate(doc, start=1):
            
            pix = page.get_pixmap(dpi=300)
            img_path = os.path.join(output_folder, f"{os.path.splitext(file)[0]}_p{page_num}.png")
            pix.save(img_path)

        doc.close()
        print(f"✅ Convertido: {file}")

print("🎉 Todos los PDFs han sido convertidos a imágenes PNG.")
